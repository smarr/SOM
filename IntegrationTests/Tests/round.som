"
VM:
  status: success
  stdout:
    1.0: 1
    1.1: 1
    1.9: 2
    -1.0: -1
    -1.1: -1
    -1.9: -2
    2^200 + 1.1: 1606938044258990275541962092341162602522202993782792835301376
    -2^200 - 1.1: -1606938044258990275541962092341162602522202993782792835301376
    tie 0.5: 1
    tie 2.5: 3
    max double < 0.5: 0
    min double > -0.5: 0
    2^52 + 1: 4503599627370497
    -2^52 - 1: -4503599627370497
    2^53 + 1 parses as 2^53: 9007199254740992
    max double < 2^63: 9223372036854774784
    2^63 - 1 parses as 2^63: 9223372036854775808
    2^63: 9223372036854775808
    -2^63: -9223372036854775808
    -2^63 - 1 parses as -2^63: -9223372036854775808
    max double < -2^63: -9223372036854777856
    10^23 (inexact): 99999999999999991611392
    -10^23 (inexact): -99999999999999991611392
    max double: 
    -max double: -
"

round = (
    run = (
        self desc: '1.0' value: 1.0 round.
        self desc: '1.1' value: 1.1 round.
        self desc: '1.9' value: 1.9 round.
        self desc: '-1.0' value: -1.0 round.
        self desc: '-1.1' value: -1.1 round.
        self desc: '-1.9' value: -1.9 round.
        self desc: '2^200 + 1.1' value: ((1 << 200) + 1.1) round.
        self desc: '-2^200 - 1.1' value: ((-1 << 200) - 1.1) round.
        self desc: 'tie 0.5' value: 0.5 round.
        self desc: 'tie 2.5' value: 2.5 round.
        self desc: 'max double < 0.5' value: 0.49999999999999994 round.
        self desc: 'min double > -0.5' value: -0.49999999999999994 round.
        self desc: '2^52 + 1' value: 4503599627370497.0 round.
        self desc: '-2^52 - 1' value: -4503599627370497.0 round.
        self desc: '2^53 + 1 parses as 2^53' value: 9007199254740993.0 round.
        self desc: 'max double < 2^63' value: 9223372036854774784.0 round.
        self desc: '2^63 - 1 parses as 2^63' value: 9223372036854775807.0 round.
        self desc: '2^63' value: 9223372036854775808.0 round.
        self desc: '-2^63' value: -9223372036854775808.0 round.
        self desc: '-2^63 - 1 parses as -2^63' value: -9223372036854775809.0 round.
        self desc: 'max double < -2^63' value: -9223372036854777856.0 round.
        self desc: '10^23 (inexact)' value: 100000000000000000000000.0 round.
        self desc: '-10^23 (inexact)' value: -100000000000000000000000.0 round.
        self desc: 'max double' value: .0 round.
        self desc: '-max double' value: -.0 round.
    )

    desc: desc value: value = (
        (desc + ': ') print.
        value println
    )
)
